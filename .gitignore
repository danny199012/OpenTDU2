# Build output
build/
build-*/
cmake-build-*/
out/

# IDE / OS
.DS_Store
.vscode/
.idea/
*.xcodeproj/
*.swp

# Game data is never committed (copyrighted, from your own TDU2 install)
*.bnk
*.big
*.cpr
*.ppm

# Extracted game banks kept for analysis (the HUD flash bank dump)
page_001.2db/

# Extracted game content: kept locally for the RE work, never committed
# (the specs under docs/re/ reference them as local files)
docs/re/ps3/classes.txt
docs/re/ps3/flash_globals.txt
docs/re/ps3/menu_strings.txt
docs/re/ps3/pc_ps3_anchors.json
docs/re/ps3/physics_names.txt
docs/re/ps3/ps3_enc_twins.json
docs/re/savegame_schema_360.txt

# Session screenshots: local evidence only (raw PNGs stay out of the repo).
# Only compressed .webp copies that the README / specs reference are tracked;
# a new shot becomes tracked by converting it to .webp (or git add -f for one)
docs/images/*
!docs/images/*.webp

# Local archives and helper scripts
*.tgz
push_camille.sh
.camille_token

# Session scratch: run logs, screenshots, extracted config probes.
_*
opentdu2.log
opentdu2-watchdog.log
.zcode/

# AMD FidelityFX signed DLLs: optional runtime plugin, binary-only licence (third_party/fidelityfx-api/LICENSE.md)
third_party/fidelityfx-api/bin/
# Intel XeSS SDK: local only (headers and DLLs are not redistributable from this repo, see its LICENSE.txt)
third_party/xess-sdk/

# NVIDIA DLSS (NGX) SDK: local only (see third_party/dlss-sdk/LICENSE.txt)
third_party/dlss-sdk/
