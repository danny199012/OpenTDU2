# StampBuildInfo.cmake - script mode (-P), run by the build_info target
# (cmake/BuildInfo.cmake) on every build. Probes git for the build number
# (rev-list --count HEAD), the short hash and the dirty flag, and rewrites
# OUT_FILE only when the stamp changed (compare + write), so a no-op rebuild
# touches nothing while a new commit recompiles just the files that include
# build_info.h. Outside a git tree (a tester's zip) or without git: the game
# still builds, with "unknown" values.
#
#   cmake -DGIT_EXECUTABLE=... -DSOURCE_DIR=... -DOUT_FILE=... -P StampBuildInfo.cmake

set( BUILD_NUMBER "0" )
set( BUILD_HASH "unknown" )
set( BUILD_DIRTY "" )
set( BUILD_BRANCH "unknown" )

if ( GIT_EXECUTABLE )
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE BUILD_NUMBER
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _rc_number )
    if ( NOT _rc_number EQUAL 0 )
        set( BUILD_NUMBER "0" )
    endif()

    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE BUILD_HASH
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _rc_hash )
    if ( NOT _rc_hash EQUAL 0 )
        set( BUILD_HASH "unknown" )
    endif()

    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --abbrev-ref HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE BUILD_BRANCH
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _rc_branch )
    if ( NOT _rc_branch EQUAL 0 )
        set( BUILD_BRANCH "unknown" )
    endif()

    execute_process(
        COMMAND "${GIT_EXECUTABLE}" status --porcelain
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE _status
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET )
    if ( NOT "${_status}" STREQUAL "" )
        set( BUILD_DIRTY "+dirty" )
    endif()
endif()

set( _content "// Generated by cmake/StampBuildInfo.cmake at build time - do not edit.
// Rewritten only when the stamp changes, so just the files including this
// recompile. The compile timestamp is __DATE__/__TIME__ (OTDU_BUILD_TIMESTAMP),
// which stays frozen for as long as the file does not recompile - the actual
// moment this binary was built.
#pragma once

#define OTDU_BUILD_NUMBER \"${BUILD_NUMBER}\"
#define OTDU_BUILD_HASH \"${BUILD_HASH}\"
#define OTDU_BUILD_DIRTY \"${BUILD_DIRTY}\"
#define OTDU_BUILD_BRANCH \"${BUILD_BRANCH}\"
#define OTDU_BUILD_STRING \"build ${BUILD_NUMBER} (${BUILD_HASH}${BUILD_DIRTY})\"
#define OTDU_BUILD_FULL_STRING \"build ${BUILD_NUMBER} (${BUILD_HASH}${BUILD_DIRTY}) · ${BUILD_BRANCH}\"
#define OTDU_BUILD_TIMESTAMP __DATE__ \" \" __TIME__
" )

set( _old "" )
if ( EXISTS "${OUT_FILE}" )
    file( READ "${OUT_FILE}" _old )
endif()

if ( NOT _old STREQUAL _content )
    file( WRITE "${OUT_FILE}" "${_content}" )
    message( STATUS "build_info: build ${BUILD_NUMBER} (${BUILD_HASH}${BUILD_DIRTY})" )
endif()
