#version 460
#extension GL_EXT_ray_query : require

// One ray per invocation against a top level acceleration structure, for the
// self test of the ray tracing path (docs/re/ray_tracing.md). Writes the first
// committed hit to a storage buffer the host reads back.

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT accel;

layout(set = 0, binding = 1, std430) buffer ResultBuffer {
    uint Hit;
    float Distance;
    uint Instance;
    uint Primitive;
} result;

layout(push_constant) uniform PushConstants {
    vec4 Origin;
    vec4 Direction;
    vec4 Params; // x: maximum distance
} pc;

void main() {
    rayQueryEXT rayQuery;
    rayQueryInitializeEXT( rayQuery, accel, gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, pc.Origin.xyz, 0.0,
                           pc.Direction.xyz, pc.Params.x );
    while ( rayQueryProceedEXT( rayQuery ) ) {
    }
    if ( rayQueryGetIntersectionTypeEXT( rayQuery, true ) == gl_RayQueryCommittedIntersectionNoneEXT ) {
        result.Hit = 0u;
        result.Distance = 0.0;
        result.Instance = 0xffffffffu;
        result.Primitive = 0xffffffffu;
        return;
    }
    result.Hit = 1u;
    result.Distance = rayQueryGetIntersectionTEXT( rayQuery, true );
    result.Instance = uint( rayQueryGetIntersectionInstanceCustomIndexEXT( rayQuery, true ) );
    result.Primitive = rayQueryGetIntersectionPrimitiveIndexEXT( rayQuery, true );
}
